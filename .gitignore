# See https://help.github.com/articles/ignoring-files/ for more information about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pnpm-debug.log*

# env files (local secrets — never ship)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config

# logs
*.log
dev.log
dev.out.log
server.log
tool-results/
upload/

# local database artifacts (the game persists to localStorage)
db/

# sandbox / editor workspace (not part of the shipped game)
/skills/
/.zscripts/
/tests/
/download/
/examples/
/mini-services/
Caddyfile

# local dev/server logs (bun run dev | tee)
dev.log
server.log

# agent-browser debug profile from .vscode/launch.json
.vscode/.chrome-profile/

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev — rift on :3000",
      "type": "shell",
      "command": "bun run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "▲|ready|started",
          "endsPattern": "ready|Local:|started server"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "runOn": "folderOpen" }
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "bun run lint",
      "problemMatcher": ["$eslint-stylish"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "bun run typecheck",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "brand — regenerate icons & banners",
      "type": "shell",
      "command": "bun run brand",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "gates — lint + typecheck",
      "dependsOrder": "sequence",
      "dependsOn": ["lint", "typecheck"],
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}

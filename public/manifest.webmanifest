{
  "name": "ARCHMAGE: RIFTBOUND — 3D Edition",
  "short_name": "Riftbound",
  "description": "Fifty waves. Five tyrants. One last archmage — a pure arcade 3D roguelike that runs entirely in your browser. 13 elements, 78 resonances, ten terrains.",
  "id": "/Archmage/",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "landscape",
  "background_color": "#0a0812",
  "theme_color": "#0a0812",
  "categories": ["games", "entertainment"],
  "icons": [
    {
      "src": "logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "maskable-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
